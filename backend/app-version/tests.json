{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Проверка версии отвечает номером последней",
      "method": "POST",
      "path": "/",
      "body": { "action": "check", "version": "1.0.0" },
      "expectedStatus": 200,
      "expectedBody": { "latest": "string" },
      "bodyMatcher": "partial"
    },
    {
      "name": "Публикация без доступа",
      "method": "POST",
      "path": "/",
      "body": { "action": "publish", "version": "9.9.9" },
      "expectedStatus": 401
    },
    {
      "name": "Проверка версии возвращает счёт проб",
      "method": "POST",
      "path": "/",
      "body": { "action": "check", "version": "1.0.0", "machine_id": "testmachine-never-used" },
      "expectedStatus": 200,
      "expectedBody": { "trial_used": 0 },
      "bodyMatcher": "partial"
    }
  ]
}