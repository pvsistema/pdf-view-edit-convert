{
  "tests": [
    {
      "name": "OPTIONS CORS",
      "method": "OPTIONS",
      "path": "/",
      "expectedStatus": 200
    },
    {
      "name": "Список без доступа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "list"
      },
      "expectedStatus": 401
    },
    {
      "name": "Проверка несуществующего ключа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "key": "PVPDF-XXXXX-XXXXX-XXXXX-XXXXX"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "valid": false
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Проверка ключа вместе с версией одним запросом",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "key": "PVPDF-XXXXX-XXXXX-XXXXX-XXXXX",
        "app_version": "1.0.0"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "valid": false,
        "update": {
          "latest": "string"
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Ответ о лицензии приходит с подписью",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "verify",
        "key": "PVPDF-XXXXX-XXXXX-XXXXX-XXXXX",
        "machine_id": "testmachine01"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "valid": false,
        "signed": {
          "sig": "string",
          "payload": "string"
        }
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Публичный ключ закрыт без доступа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "public_key"
      },
      "expectedStatus": 401
    },
    {
      "name": "Ключ модуля без лицензии закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "module_key",
        "module": "ocr"
      },
      "expectedStatus": 403
    },
    {
      "name": "Ключ модуля по чужому ключу закрыт",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "module_key",
        "module": "ocr",
        "key": "PVPDF-NOPE1-NOPE2-NOPE3-NOPE4"
      },
      "expectedStatus": 403
    },
    {
      "name": "Ключи сборки закрыты без доступа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "build_info"
      },
      "expectedStatus": 401
    },
    {
      "name": "Отметка о пробном запуске принимается",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "trial_event",
        "event": "used",
        "tool": "to-word",
        "used": 1,
        "machine_id": "testmachine01"
      },
      "expectedStatus": 200,
      "expectedBody": {
        "ok": true
      },
      "bodyMatcher": "partial"
    },
    {
      "name": "Статистика проб закрыта без доступа",
      "method": "POST",
      "path": "/",
      "body": {
        "action": "trial_stats"
      },
      "expectedStatus": 401
    }
  ]
}