<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Помощник для сканеров, работающих по стандарту TWAIN.

    Зачем отдельная программа. Драйверы сканеров бывают двух разрядностей,
    и Windows держит для них два independent списка, которые не видят друг
    друга: 32-разрядные драйверы лежат в twain_32, 64-разрядные в twain_64.
    Программа одной разрядности видит только "свой" список - это ограничение
    Windows, обойти его внутри одного процесса нельзя.

    Поэтому помощник собирается ДВАЖДЫ - 32- и 64-разрядным. Старые аппараты
    (Epson, Canon, HP) отзываются первому, новые МФУ (Kyocera и подобные) -
    второму. Ставятся оба, и вместе они покрывают все сканеры.

    Окна у помощника нет: он запускается незаметно и сам закрывается.
  -->

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>PVSPDF-twain</AssemblyName>
    <RootNamespace>PvsPdfTwain</RootNamespace>
    <Product>ПВ-Система PDF</Product>
    <Company>ПВ-Система</Company>
    <AssemblyTitle>Помощник сканирования</AssemblyTitle>
    <SatelliteResourceLanguages>ru</SatelliteResourceLanguages>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Разрядность задаётся при сборке: помощник собирается и 32-,
         и 64-разрядным, чтобы увидеть оба списка драйверов Windows -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EventSourceSupport>false</EventSourceSupport>
    <MetadataUpdaterSupport>false</MetadataUpdaterSupport>
  </PropertyGroup>

  <!-- В 64 разрядах стандарт TWAIN укладывает поля структур иначе.
       Признак включается сам, по разрядности сборки -->
  <PropertyGroup Condition="'$(PlatformTarget)' == 'x64' Or '$(RuntimeIdentifier)' == 'win-x64'">
    <DefineConstants>$(DefineConstants);TWAIN64</DefineConstants>
  </PropertyGroup>

</Project>